# Copy to .env locally. Never commit .env or real keys.
# Optional runtime AI uses only Groq. Start false; use a Groq Free Plan key and quota.
AI_ENABLED=false
GROQ_API_KEY=
# Model is pinned in code to qwen/qwen3.8-27b; there is no model/provider override.

# App-level anonymous-demo limits; these do not override Groq plan quotas or billing settings.
AI_DAILY_BUDGET=20
AI_BURST_PER_MINUTE=4
RATE_LIMIT_SALT=
TRUST_PROXY_HEADERS=false

# Local writable SQLite ledger path; ephemeral hosting storage may not persist.
APP_DB_PATH=./stayup_state.sqlite3
